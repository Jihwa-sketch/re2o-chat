# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 회사 SMTP / 구글 워크스페이스 계정 (PM 이메일 알림)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PM_NOTIFY_EMAIL=

# Google Sheets 적재 (구글시트에 연결한 Apps Script 웹앱 URL)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Turso (원격 libSQL) - 비워두면 로컬 SQLite 파일(data/re2o.sqlite) 사용
# 서버리스(Vercel 등)에 배포할 때는 반드시 설정해야 함
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# PM 콘솔(/admin) 패스코드 게이트 - 비워두면 게이트 없이 접근 가능
ADMIN_PASSCODE=

# Re2O Masters Summit 사전접수 대시보드(/dashboard) - 응답 시트에 연결한 Apps Script 웹앱(doGet) URL
# 설정 방법: apps-script/summit-sync.gs 참고
SUMMIT_SHEET_URL=

# 이메일 본문에 들어갈 앱 기본 URL
APP_BASE_URL=http://localhost:3000
